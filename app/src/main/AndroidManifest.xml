<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        ⚠️⚠️ **SENZA QUESTO BLOCCO L'ELENCO DEGLI EDITOR È VUOTO SU ANDROID 11 IN SU**, e non
        dà nessun errore: da quella versione un'app non vede le altre se non dichiara che
        cosa cerca, quindi `queryIntentActivities` risponde 'nessuno' su un telefono pieno di
        editor. È il genere di difetto che non si vede su un telefono vecchio.
        ⚠️ Si dichiara l'intento e non i nomi dei pacchetti: chiedere per nome vorrebbe dire
        un elenco di app scritto a mano, vecchio il giorno dopo. Vedi `Editors`.
    -->
    <queries>
        <!--
            ⚠️⚠️ DUE FORME DELLA STESSA DOMANDA, e la seconda non è ridondanza: un editor
            che nel suo filtro pretende anche lo SCHEMA (`<data android:scheme="content" .../>`)
            non risponde a un intent che porta il solo tipo, quindi con la sola prima riga
            resta invisibile. Misurato sul campo il 2026-08-31: Photo Editor
            (com.iudesk.android.photo.editor) e Magic Eraser (com.duygiangdg.magiceraser)
            erano installati e non comparivano fra le scelte.
            ⚠️ Il costo di sbagliare qui non si vede: l'elenco esce corto invece che vuoto, e
            sembra che sul telefono non ci sia nessun editor.
        -->
        <intent>
            <action android:name="android.intent.action.EDIT" />
            <data android:mimeType="image/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.EDIT" />
            <data android:scheme="content" android:mimeType="image/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.EDIT" />
            <data android:scheme="file" android:mimeType="image/*" />
        </intent>
        <!--
            ⚠️⚠️ LA CONDIVISIONE, dalla 1.11, e serve perché certe foto-app NON hanno un
            filtro di modifica: Magic Eraser (com.duygiangdg.magiceraser) non compare in
            nessun 'Modifica' di nessuna galleria, e compare fra i primi risultati di
            'Condividi'. Prova fatta dall'utente il 2026-09-01. Senza queste righe l'app
            resta invisibile anche a una query su ACTION_SEND, perché da Android 11 la
            visibilità dei pacchetti si dichiara qui.
            ⚠️ La riga sul TESTO non serve ad aprire niente: serve a ESCLUDERE. Chi accetta
            anche il testo semplice è messaggistica, posta o cloud, non una foto-app, e
            senza quel confronto l'elenco delle scelte esce con quaranta voci. Vedi Editors.
        -->
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="image/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="text/plain" />
        </intent>
    </queries>

    <!--
        Serve a UNA cosa sola: sfogliare le altre immagini della stessa cartella
        dopo averne aperta una. Senza, l'app resta quella di prima e mostra la
        sola foto scelta.
        ⚠️⚠️ È IL PERMESSO PESANTE, ed è una scelta esplicita dell'utente:
        *preferisco chiedere un permesso pesante prima e poi essere a posto per
        sempre*. Quello leggero (`READ_MEDIA_IMAGES`) sarebbe bastato a leggere il
        MediaStore, e la ragione per cui non è più dichiarato è che da Android 14
        apre la porta all'accesso PARZIALE: la persona spunta tre foto, il
        MediaStore ne mostra tre, e una cartella da quattrocento risponde 'tre'
        senza che niente segnali l'inganno.
        ⚠️ Il secondo permesso è per i soli Android 9 e 10, dove quello ampio non
        esiste e quello classico sull'archivio fa già vedere tutto: si ferma alla
        29, o il verificatore segnala un permesso chiesto a vuoto.
        ⚠️ Il primo NON si concede con un dialogo: è un permesso speciale, e la
        persona lo accende con un interruttore in una pagina di sistema (vedi
        `Folder.settingsIntents`).
    -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <!-- Il visualizzatore non è utile senza uno schermo decente, ma non
         pretende nulla di più: niente fotocamera, niente posizione.
         NOTA: nemmeno un permesso per scrivere. Il salvataggio passa dal
         selettore di sistema (ACTION_CREATE_DOCUMENT), che non ne chiede alcuno
         e in più lascia scegliere dove: su Android 9, che questa app supporta,
         scrivere nella galleria via MediaStore avrebbe voluto
         WRITE_EXTERNAL_STORAGE. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!--
        ⚠️ IL BLOCCO `queries` È TORNATO, in cima, ma dichiara un'altra cosa: dalla
        1.03 serve a trovare gli editor di immagini. Quello di prima nominava l'app
        Google per la ricerca immagine ed è uscito con lei nella 0.18. La regola
        resta quella: `queries` è una finestra sulle app altrui e non si tiene
        aperta per niente, quindi chi toglie una funzione toglie anche la sua riga.
    -->

    <!--
        AIV si registra come visualizzatore per i link diretti a un'immagine.
        Tre filtri, e servono tutti e tre:
        1) image/* per i file locali e i content:// che arrivano da un'altra app;
        2) http e https con pathPattern, che è l'unico modo di dire 'link che
           finisce in .jpg' fino ad Android 11;
        3) pathSuffix, che da Android 12 fa lo stesso confronto ma sulla sola
           CODA del percorso, e quindi regge anche i percorsi che hanno un punto
           prima del nome del file, dove il filtro 2 cade.
        Le versioni vecchie ignorano l'attributo che non conoscono, quindi i due
        modi convivono senza guardie.

        NOTA: android:autoVerify è dichiarato FALSE, non omesso. La verifica dei
        link vale per i domini che si possiedono, non per 'qualunque sito che
        serva un jpg': senza di essa AIV compare nella scelta 'Apri con', che è
        esattamente il comportamento voluto per un visualizzatore. Scriverlo
        invece di tacerlo è la forma che lint stesso propone, e dice a chi legge
        che l'assenza della verifica è una scelta e non una dimenticanza.
    -->

    <!--
        ⚠️⚠️ Le icone stanno in `mipmap-anydpi-v26/` e QUEL `-v26` NON si toglie,
        benché lint lo dichiari inutile con minSdk 28 (avviso ObsoleteSdkInt,
        'merge all the resources in this folder into mipmap-anydpi'). Provato:
        rinominata la cartella in `mipmap-anydpi`, AAPT2 non registra più la
        risorsa e il build fallisce con 'resource mipmap/ic_launcher not found'.
        È un consiglio che rompe, e senza questa nota il prossimo che legge
        l'avviso lo rifà.
    -->
    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AIV">

        <activity
            android:name=".ViewerActivity"
            android:exported="true"
            android:label="@string/app_short_name"
            android:launchMode="singleTop"
            android:theme="@style/Theme.AIV">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 1) immagini locali e condivise da altre app -->
            <intent-filter android:label="@string/app_short_name">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="image/*" />
            </intent-filter>

            <intent-filter android:label="@string/app_short_name">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>

            <!-- 2) link diretti, fino ad Android 11 -->
            <intent-filter android:autoVerify="false" android:label="@string/app_short_name">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:host="*" />
                <data android:pathPattern=".*\\.jpg" />
                <data android:pathPattern=".*\\.JPG" />
                <data android:pathPattern=".*\\.jpeg" />
                <data android:pathPattern=".*\\.JPEG" />
                <data android:pathPattern=".*\\.jpe" />
                <data android:pathPattern=".*\\.JPE" />
                <data android:pathPattern=".*\\.png" />
                <data android:pathPattern=".*\\.PNG" />
                <data android:pathPattern=".*\\.gif" />
                <data android:pathPattern=".*\\.GIF" />
                <data android:pathPattern=".*\\.tif" />
                <data android:pathPattern=".*\\.TIF" />
                <data android:pathPattern=".*\\.tiff" />
                <data android:pathPattern=".*\\.TIFF" />
                <data android:pathPattern=".*\\.webp" />
                <data android:pathPattern=".*\\.WEBP" />
                <data android:pathPattern=".*\\.avif" />
                <data android:pathPattern=".*\\.AVIF" />
                <data android:pathPattern=".*\\.heic" />
                <data android:pathPattern=".*\\.HEIC" />
                <data android:pathPattern=".*\\.heif" />
                <data android:pathPattern=".*\\.HEIF" />
                <data android:pathPattern=".*\\.svg" />
                <data android:pathPattern=".*\\.SVG" />
            </intent-filter>

            <!--
                3) link diretti, da Android 12, con `pathSuffix`: un confronto
                di sola coda (`String.endsWith`), che è esattamente la domanda
                che vogliamo fare.

                ⚠️⚠️ QUI STAVA UN `pathAdvancedPattern`, dalla 0.10 alla 0.15, e
                NON HA MAI RICONOSCIUTO NIENTE. Due difetti sovrapposti, tutti e
                due misurati contro il codice vero di `PatternMatcher` (AOSP):
                - La sintassi non è quella delle espressioni regolari: conosce
                  il punto, gli insiemi `[...]`, i modificatori `*`, `+`,
                  `{n,m}` e l'escape, e basta. Niente alternative `|`, niente
                  gruppi `(...)`, niente `?`. Il vecchio pattern li usava tutti
                  e tre. ⚠️ E il parser NON si lamenta: manda al ramo dei
                  letterali quello che non conosce, quindi l'app si installa
                  senza un avviso e il filtro resta arredamento.
                - ⚠️⚠️ Ma soprattutto: con quel motore `.*` all'INIZIO non può
                  funzionare mai, e questo vale anche per la correzione ovvia
                  (una riga per estensione con gli insiemi). Il confronto è
                  goloso e SENZA ritorno indietro: `.*` si mangia tutta la
                  stringa e a quello che segue non resta niente da leggere.
                  Provato: dieci pattern scritti bene riconoscono zero percorsi
                  su trentaquattro.
                - `pathPattern` del filtro 2 non ha il difetto perché il suo
                  motore è un altro: là `.*` si ferma alla PRIMA occorrenza del
                  carattere che segue.
                - ⚠️ Il prezzo di `pathSuffix` è che la coda è letterale, quindi
                  le maiuscole si elencano come nel filtro 2. Il guadagno vero è
                  un altro, ed è il motivo per cui questo filtro esiste: il
                  filtro 2 CADE sui percorsi con un punto prima del nome (il suo
                  `.*` si ferma lì), mentre `/2026.08/foto.jpg` è un indirizzo
                  normalissimo. Misurato: `pathPattern` lo rifiuta, `pathSuffix`
                  lo prende.
                - ⚠️ Niente coda per la query (`?...`): il confronto avviene su
                  `Uri.getPath()` (`IntentFilter.matchData`), che la query non
                  la contiene.
            -->
            <intent-filter android:autoVerify="false" android:label="@string/app_short_name">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:host="*" />
                <data android:pathSuffix=".jpg" />
                <data android:pathSuffix=".JPG" />
                <data android:pathSuffix=".jpeg" />
                <data android:pathSuffix=".JPEG" />
                <data android:pathSuffix=".jpe" />
                <data android:pathSuffix=".JPE" />
                <data android:pathSuffix=".png" />
                <data android:pathSuffix=".PNG" />
                <data android:pathSuffix=".gif" />
                <data android:pathSuffix=".GIF" />
                <data android:pathSuffix=".tif" />
                <data android:pathSuffix=".TIF" />
                <data android:pathSuffix=".tiff" />
                <data android:pathSuffix=".TIFF" />
                <data android:pathSuffix=".webp" />
                <data android:pathSuffix=".WEBP" />
                <data android:pathSuffix=".avif" />
                <data android:pathSuffix=".AVIF" />
                <data android:pathSuffix=".heic" />
                <data android:pathSuffix=".HEIC" />
                <data android:pathSuffix=".heif" />
                <data android:pathSuffix=".HEIF" />
                <data android:pathSuffix=".svg" />
                <data android:pathSuffix=".SVG" />
            </intent-filter>
        </activity>

        <!--
            Serve alle tre voci del menu che consegnano l'immagine a un'altra app:
            copia negli appunti, condividi, ricerca immagine su un file locale.
            Un percorso di file nudo non basta e non è una formalità: da Android 7
            un `file://` passato a un'altra app solleva FileUriExposedException, e
            l'unica via è un content:// su cui il sistema concede la lettura a chi
            lo riceve. Esposto NO: il permesso lo dà l'intent, uno alla volta.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
