    <string name="settings_folder_columns">Kolom pada kisi folder</string>
    <string name="settings_folder_columns_desc">Semakin banyak kolom, semakin banyak folder yang masuk ke layar dan semakin kecil setiap sampul. Pada empat kolom, nama di bawahnya biasanya terpotong.</string>
    <string name="settings_folder_count">Jumlah item di bawah folder</string>
    <string name="settings_hand">Posisi fungsi utama</string>
