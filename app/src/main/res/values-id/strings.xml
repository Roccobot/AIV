    <string name="settings_list_path">Daftar berkas: salin juga jalur foldernya</string>
    <string name="settings_folder_count_desc">Di bawah setiap sampul, berapa gambar yang ada di folder itu. Jika dimatikan, barisnya menjadi lebih pendek dan bagian judul di atas tumbuh sebanyak itu.</string>
    <string name="settings_fit_grow">Perbesar gambar kecil</string>
    <string name="settings_fit_grow_desc">Jika mati, gambar yang lebih kecil dari layar ditampilkan pada ukuran aslinya. Jika hidup, ia tumbuh hingga memenuhi layar.</string>
    <string name="settings_zoom_max">Perbesaran terjauh</string>
    <string name="settings_scale_mode">Arti 100%</string>
    <string name="settings_scale_physical">Satu piksel berkas per piksel layar</string>
    <string name="settings_scale_logical">Satu piksel berkas per piksel tata letak</string>
    <string name="settings_scale_desc">Layar ponsel memadatkan dua atau tiga piksel nyata ke dalam satu piksel tata letak, jadi kedua jawabannya berjauhan: yang pertama menampilkan berkas apa adanya, yang kedua menampilkannya seukuran yang akan ditampilkan sebuah halaman web.</string>
    <string name="details_bar">Bilah detail</string>
