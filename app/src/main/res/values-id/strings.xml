    <string name="settings_info_visible">Bilah tampak sejak awal</string>
    <string name="settings_reverse_order">Ubah arah urutan gambar (menurut tanggal)</string>
    <string name="settings_reverse_order_desc">Jika mati, kamu menelusuri dari gambar terbaru menuju yang lebih lama, seperti galeri ponsel. Jika hidup, menurut urutan waktu, dari yang tertua ke yang terbaru.</string>
    <string name="settings_clipboard">Baca papan klip saat mulai</string>
    <string name="settings_clipboard_desc">Saat membuka aplikasi dari ikonnya, sebuah alamat di papan klip yang mengarah langsung ke gambar akan membuka gambar itu. Android menampilkan pemberitahuan setiap kali aplikasi membaca papan klip, jadi membiarkan ini mati berarti tidak pernah melihatnya.</string>
    <string name="settings_start_folder">Buka folder saat mulai</string>
    <string name="settings_start_folder_desc">Saat aplikasi dibuka, gambar di folder pilihanmu langsung tampil, bukan daftar folder.</string>
