    <string name="settings_ui_theme">Tema</string>
    <string name="settings_ui_theme_desc">Apakah aplikasinya sendiri terang atau gelap. Berbeda dari latar di belakang gambar, tepat di bawah: papan kotak ada untuk menampakkan transparansi, bukan untuk menyelaraskan warna.</string>
