    <string name="settings_list_path">Danh sách tệp: chép cả đường dẫn thư mục</string>
    <string name="settings_folder_count_desc">Dưới mỗi ảnh bìa, thư mục chứa bao nhiêu ảnh. Khi tắt, hàng sẽ ngắn lại và phần tiêu đề ở trên cao thêm đúng chừng ấy.</string>
    <string name="settings_fit_grow">Phóng to ảnh nhỏ</string>
    <string name="settings_fit_grow_desc">Khi tắt, ảnh nhỏ hơn màn hình được hiển thị ở kích thước thật. Khi bật, ảnh lớn lên cho đầy khung hình.</string>
    <string name="settings_zoom_max">Mức phóng xa nhất</string>
    <string name="settings_scale_mode">100% nghĩa là gì</string>
    <string name="settings_scale_physical">Một điểm ảnh của tệp trên một điểm ảnh màn hình</string>
    <string name="settings_scale_logical">Một điểm ảnh của tệp trên một điểm ảnh bố cục</string>
    <string name="settings_scale_desc">Màn hình điện thoại dồn hai hoặc ba điểm ảnh thật vào một điểm ảnh bố cục, nên hai câu trả lời cách nhau rất xa: cái đầu cho thấy tệp đúng như nó là, cái sau cho thấy nó ở kích thước mà một trang web sẽ hiển thị.</string>
