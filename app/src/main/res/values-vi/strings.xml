    <string name="settings_bottom">Ở dưới</string>
    <string name="settings_info_visible">Thanh hiện ngay từ đầu</string>
    <string name="settings_reverse_order">Đổi chiều thứ tự (theo ngày)</string>
    <string name="settings_reverse_order_desc">Khi tắt, bạn xem từ mới nhất về những cái cũ hơn, như thư viện điện thoại. Khi bật, theo thứ tự thời gian, từ cũ nhất đến mới nhất.</string>
    <string name="settings_clipboard">Đọc bảng nhớ tạm khi khởi động</string>
    <string name="settings_clipboard_desc">Khi mở ứng dụng từ biểu tượng của nó, một địa chỉ trong bảng nhớ tạm trỏ thẳng tới ảnh sẽ mở ảnh đó. Android hiện một thông báo mỗi lần ứng dụng đọc bảng nhớ tạm, nên để tắt mục này nghĩa là không bao giờ thấy nó.</string>
    <string name="settings_start_folder">Mở một thư mục khi khởi động</string>
    <string name="settings_start_folder_desc">Khi mở ứng dụng, nội dung thư mục đã chọn hiện ra ngay, thay vì danh sách thư mục.</string>
