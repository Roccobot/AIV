    <string name="settings_ui_theme">Chủ đề</string>
    <string name="settings_ui_theme_desc">Bản thân ứng dụng là sáng hay tối. Khác với nền phía sau ảnh ngay bên dưới: ô bàn cờ ở đó để cho thấy độ trong suốt, không phải để hợp màu.</string>
