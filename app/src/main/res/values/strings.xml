        <item quantity="one">%2$s in %1$d file</item>
        <item quantity="other">%2$s in %1$d files</item>
    </plurals>

    <!-- ── The facts about one file: the field names, used BOTH as the settings rows and
         as the labels in the dialog. One name for one thing, in one place. ── -->
    <string name="facts_name">File name</string>
    <string name="facts_kind">File type</string>
    <string name="facts_pixels">Pixels</string>
    <string name="facts_size">Size</string>
    <string name="facts_taken">Date taken</string>
    <string name="facts_modified">Last modified</string>
    <string name="facts_folder">Folder</string>
    <string name="facts_encoding">Encoding</string>
    <string name="facts_colours">Colour mode</string>
    <string name="facts_frames">Frames</string>
    <string name="facts_duration">Duration</string>
    <string name="facts_colour_grey">Greyscale</string>
    <string name="facts_colour_indexed">Indexed colour</string>
    <string name="facts_colour_rgb">RGB</string>
    <string name="facts_colour_rgba">RGBA</string>
    <string name="facts_colour_bits">%1$s %2$d bit</string>
    <string name="facts_colour_channel">%1$d bit/channel</string>
    <string name="facts_colour_alpha">with transparency</string>
    <string name="facts_duration_s">%1$s s</string>
    <string name="facts_camera">Shot data</string>
    <string name="facts_place">Geographic coordinates</string>

    <!-- Width, height, and megapixels when there are enough of them to be worth saying. -->
    <string name="facts_pixels_value">%1$d x %2$d</string>
    <string name="facts_pixels_mpx">%1$d x %2$d\n%3$s Mpx</string>
    <!-- The scan order: one word for JPEG, another for PNG, same idea. -->
    <string name="facts_progressive">progressive</string>
    <string name="facts_interlaced">interlaced</string>
    <!-- A plural because English says "1 bit" and "8 bits", and lint is right to insist:
         the bit depth of a channel is a count like any other. -->
    <plurals name="facts_bits">
        <item quantity="one">%1$d bit</item>
        <item quantity="other">%1$d bits</item>
    </plurals>
    <string name="facts_focal">%1$s mm</string>
    <string name="facts_exposure_fraction">1/%1$d s</string>
    <string name="facts_exposure_seconds">%1$s s</string>
    <string name="facts_iso">ISO %1$d</string>
    <string name="facts_altitude">%1$d m a.s.l.</string>
    <string name="facts_altitude_label">Altitude</string>

        <!-- ── Choosing a destination folder in the filesystem ── -->
    <string name="dest_storages">Storage</string>
    <string name="dest_empty">No folder in here.</string>
    <string name="dest_new">New folder</string>
    <string name="dest_create">Create</string>
    <string name="dest_here">Copy into %1$s</string>
    <string name="dest_move_here">Move into %1$s</string>
    <string name="menu_copy_here">Copy</string>
    <plurals name="copy_done">
        <item quantity="one">%1$d item copied</item>
        <item quantity="other">%1$d items copied</item>
    </plurals>
    <plurals name="move_done">
        <item quantity="one">%1$d item moved</item>
        <item quantity="other">%1$d items moved</item>
    </plurals>
    <plurals name="rename_done">
        <item quantity="one">%1$d item renamed</item>
        <item quantity="other">%1$d items renamed</item>
    </plurals>
    <plurals name="delete_done">
        <item quantity="one">%1$d item deleted</item>
        <item quantity="other">%1$d items deleted</item>
    </plurals>
    <!-- One for all four operations: 'did not go through' fitted a copy and read oddly
         after a deletion, and four wordings of the same notice are four places where a
         translation can fall behind. -->
    <plurals name="op_failed">
        <item quantity="one">%1$d did not go through</item>
        <item quantity="other">%1$d did not go through</item>
    </plurals>

    <!-- ── Renaming in bulk ── -->
    <string name="rename_template">Name</string>
    <string name="rename_select_all">Select all</string>
    <string name="rename_clear">Clear</string>
    <string name="rename_start">First number</string>
    <string name="rename_hint">Every run of hashes becomes the number, and how many you write is how many digits: ## gives 01, ### gives 001. The extension is never touched, and the files are numbered in alphabetical order.</string>
    <string name="rename_preview">Preview</string>
    <string name="rename_ext">Extension</string>
    <string name="rename_ext_label">New extension</string>
    <string name="rename_ext_note">It changes the NAME, not the format: the file keeps the content it has. To really convert it, use \'Export and convert\'.</string>

    <!-- ── Deleting ── -->
    <string name="delete_ask">Confirm deletion?</string>
    <!-- The definitive one: inside the bin, or when emptying it. The old text said AIV
         had no bin of its own, and from 0.64 that is no longer true. -->
    <plurals name="delete_desc">
        <item quantity="one">You are about to delete %1$d item for good: it goes from the phone for ever.</item>
        <item quantity="other">You are about to delete %1$d items for good: they go from the phone for ever.</item>
    </plurals>

    <!-- ── The bin ── -->
    <string name="bin_title">Bin</string>
    <string name="bin_none">The bin is empty.</string>
    <string name="bin_restore">Restore</string>
    <string name="bin_empty">Empty the bin</string>
    <string name="bin_empty_ask">Really empty the bin?</string>
    <string name="bin_empty_desc">You will not be able to get its contents back.</string>
    <string name="bin_restore_all_ask">Really restore all the files?</string>
    <string name="bin_restore_all_desc">Every item will go back to its own folder of origin: to see where it was moved, check the bin history.</string>
    <string name="bin_empty_hint">Shortcut: press and hold the floating button to empty the bin.</string>
    <string name="bin_restore_all">Restore everything</string>
    <string name="bin_history">History</string>
    <!-- The history of restores: where the files that left the bin ended up. The number
         comes from History.DAYS instead of being written into the sentence, so the text
         and the real deadline cannot drift apart. -->
    <string name="history_title">Restore history</string>
    <string name="history_none">Nothing has been restored in the last %1$d days.</string>
    <string name="history_note">The history keeps the last %1$d days, then empties itself.</string>
    <plurals name="trash_done">
        <item quantity="one">%1$d file moved to the bin</item>
        <item quantity="other">%1$d files moved to the bin</item>
    </plurals>
    <plurals name="restore_done">
        <item quantity="one">%1$d restored</item>
        <item quantity="other">%1$d restored</item>
    </plurals>

    <plurals name="folders_count">
        <item quantity="one">%1$d picture</item>
        <item quantity="other">%1$d pictures</item>
    </plurals>
    <plurals name="folders_clips">
        <item quantity="one">%1$d video</item>
        <item quantity="other">%1$d videos</item>
    </plurals>

    <!-- ── Which facts about a file to show, and in which order ── -->
    <string name="settings_facts">Info on a single file</string>
    <!-- The dialog's own title, centred. Separate from pick_info, which is also the
         label under an icon in the action pad, where three words would wrap to three
         lines. -->
    <string name="facts_title">Information</string>
    <string name="settings_facts_desc">Which data you see when you open Info on a file, and in which order. Name, pixels and size are always there; a datum the file does not carry gets no row at all.</string>
    <plurals name="settings_facts_count">
        <item quantity="one">%1$d field shown</item>
        <item quantity="other">%1$d fields shown</item>
    </plurals>
    <string name="settings_facts_always">Always shown</string>
    <string name="settings_facts_up">Move up</string>
    <string name="settings_facts_down">Move down</string>

    <!-- The notice at the bottom of the grid when the system Back gesture clears a
         selection: the sentence on the left, and on the right the button that puts
         the selection back. pick_undo says the same word as editor_undo and is a key
         of its own because that one is a label under an icon in the editor's action
         pad, where a long language shortens it. -->
    <string name="pick_cleared">No files selected.</string>
    <string name="pick_undo">Undo</string>
    <string name="pick_list_done">File list copied to the clipboard</string>
    <string name="settings_pick_weight">Size of the selected files</string>
    <string name="settings_pick_weight_desc">At the top of the selection, next to the counter, the total size of every selected item appears. It changes with every change to the selection.</string>
    <string name="anim_play">Play</string>
    <string name="anim_pause">Pause</string>
    <string name="anim_prev">Previous frame</string>
    <string name="anim_next">Next frame</string>
    <plurals name="facts_colour_count">
        <item quantity="one">%1$d colour</item>
        <item quantity="other">%1$d colours</item>
    </plurals>
    <string name="settings_buttons">Button order</string>
    <string name="settings_buttons_menu">Menu on a file</string>
    <string name="settings_buttons_turn">Editor: rotate and centre</string>
    <string name="settings_buttons_steps">Editor: undo and apply</string>
    <string name="settings_labels">Labels under icons</string>
    <string name="settings_labels_desc">If turned off, the icon panels get more compact. List menus are unchanged.</string>
    <string name="settings_buttons_how">Press and hold a button, then drag it to change its place within its panel.</string>
    <string name="settings_buttons_reset">Reset</string>
