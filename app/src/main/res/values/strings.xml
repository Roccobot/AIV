    <!-- Count and size on one line: they measure one thing, not two separate facts.
         With a single file 'in total' says nothing and is dropped. -->
    <!-- The size first and the count second, as the user asked: what a selection weighs
         is the number people are after, and the count is already in the bar above. -->
    <plurals name="pick_facts">
        <item quantity="one">%2$s in %1$d file</item>
        <item quantity="other">%2$s in %1$d files</item>
    </plurals>

    <!-- ── The facts about one file: the field names, used BOTH as the settings rows and
