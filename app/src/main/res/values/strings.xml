    <!-- ── Renaming in bulk ── -->
    <string name="rename_template">Name</string>
    <string name="rename_start">First number</string>
    <string name="rename_hint">Every run of hashes becomes the number, and how many you write is how many digits: ## gives 01, ### gives 001. The extension is never touched, and the pictures are numbered in alphabetical order.</string>
