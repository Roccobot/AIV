    <string name="hub_view_tree">System folders</string>
    <string name="hub_search">Search</string>

    <!-- ── The system folders view ── -->
    <string name="tree_up">Up one folder</string>
    <string name="tree_empty">Nothing in here.</string>
    <!-- On a folder the owner hid from the other views: this one shows it anyway,
         because a file browser that hides a folder that IS on the disk lies about
         the disk. The mark says why it is missing elsewhere. -->
    <string name="tree_hidden">hidden</string>
    <!-- Said when a file that is neither a picture nor a film cannot be handed over:
         either no app claims that kind, or the MediaStore has not indexed it yet and
         there is no address to grant. -->
    <string name="tree_unopenable">No app on this phone can open it</string>
    <string name="hub_url">Open an address</string>
    <string name="hub_pick">Open a picture</string>
    <string name="hub_settings">Settings</string>
    <string name="url_open">Open</string>
    <string name="url_recent">Opened before</string>
    <string name="folder_empty">This folder holds no pictures any more.</string>
    <string name="cancel">Cancel</string>

    <string name="hide_folder_title">Hide %1$s?</string>
    <string name="hide_folder_desc">It stops showing up among the folders to leaf through. Nothing is deleted: the pictures stay where they are, and you can bring the folder back from the settings.</string>
    <string name="hide_folder_do">Hide</string>
    <string name="settings_hidden">Hidden folders</string>
    <string name="settings_hidden_desc">Long press a folder to hide it. These no longer show up in the list, but they are untouched on the phone.</string>
    <string name="settings_hidden_show">Show</string>
    <string name="settings_hidden_none">No hidden folders</string>
    <plurals name="settings_hidden_count">
        <item quantity="one">%1$d folder</item>
        <item quantity="other">%1$d folders</item>
    </plurals>

    <!-- ── Searching the pictures on the phone ── -->
    <!-- It names the field it searches, because that is the honest promise: the file
