<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        The app is bilingual like 'Decent Image Viewer', but here ANDROID picks
        the language: strings live in values/ (English) and values-it/ (Italian)
        and the system takes the right one. A text table inside the code, like
        the userscript has, would be a second way of doing what the platform
        already does by itself.
        WARNING: whoever adds a string adds it to BOTH files.

        FULL STOPS follow the ROLE of the string, not the ear, which is the rule
        the userscript arrived at and the only version of it that can be checked
        by machine: descriptions and explanations take one, and everything that
        is an interface element does not. Labels, buttons, menu entries, toasts
        and content descriptions are fragments, not sentences.
    -->
    <string name="app_name">Astonishing Image Viewer</string>
    <!-- Room under the icon is short: the full name shows up elsewhere. -->
    <string name="app_short_name">AIV</string>

    <string name="no_image">No image to show</string>
    <string name="open_failed">This image could not be opened</string>
    <string name="unsupported">This format is not supported yet</string>
    <string name="too_large">The image is too large for this device</string>
    <!-- Mostly for the network: a passing 403, a tunnel, a slow server. Without it
         the only way out of a failure was Back and the whole address again. -->
    <string name="error_retry">Try again</string>

    <string name="fit_label">Fit to view</string>

    <!-- ── Asking for an address ── -->
    <string name="url_hint">https://example.com/picture.jpg</string>
    <string name="url_forget">Forget these</string>
    <string name="url_not_image">The URL does not point to an image</string>

    <!-- ── The menu that a long press opens on the picture ── -->
    <string name="menu_copy_image">Copy image</string>
    <string name="menu_share">Share</string>
    <string name="menu_save">Save</string>
    <string name="menu_details">Details</string>

    <string name="toast_image_copied">Image copied</string>
    <string name="toast_copy_failed">The copy did not go through</string>
    <string name="toast_saved">Saved</string>
    <string name="toast_save_failed">Saving did not go through</string>

    <string name="folder_why">To leaf through the rest of the folder, AIV needs access to all files. Turn the switch on in the page that just opened.</string>
    <!-- Shown in the details row in place of the '3/7' position, so that a swipe
         that does nothing says WHY instead of just failing. One per reason, and
         it is having one for EACH that makes the feature diagnosable from the
         outside: a single catch-all note would put back the silence it removes. -->
    <string name="folder_no_access">no access to the folder</string>
    <string name="folder_unreadable">name and size unreadable</string>
    <string name="folder_not_in_gallery">not in the gallery (%1$s)</string>
    <string name="folder_alone">alone in its folder</string>
    <string name="folder_lost">not found in its folder</string>

    <!-- ── Settings ── -->
    <string name="settings_title">Settings</string>
    <string name="settings_back">Back</string>

    <string name="settings_background">Behind the picture</string>
    <string name="settings_bg_checker">Checkerboard</string>
    <string name="settings_bg_solid">Flat colour</string>
    <string name="settings_bg_desc">The checkerboard is the only background that makes transparency visible, which on a viewer is information rather than decoration.</string>

    <string name="settings_ui_theme">Theme</string>
    <string name="settings_ui_theme_desc">Whether the app itself is light or dark. Separate from the background behind a picture, just below: a checkerboard is there to show transparency, not to match.</string>
    <string name="settings_system">System</string>
    <string name="settings_theme_light">Light</string>
    <string name="settings_theme_dark">Dark</string>

    <string name="settings_bg_theme">Background tint</string>
    <string name="settings_auto">Automatic</string>
    <string name="settings_light">Light</string>
    <string name="settings_dark">Dark</string>

    <string name="settings_folder_columns">Columns in the folder grid</string>
    <string name="settings_folder_columns_desc">More columns fit more folders on screen and shrink each cover. At four the name under it is usually cut short.</string>

    <string name="settings_fit_grow">Enlarge small pictures</string>
    <string name="settings_fit_grow_desc">Off, a picture smaller than the screen is shown at its real size. On, it grows to fill the view.</string>

    <string name="settings_zoom_max">Furthest zoom</string>

    <string name="settings_scale_mode">What 100% means</string>
    <string name="settings_scale_physical">One pixel of the file per screen pixel</string>
    <string name="settings_scale_logical">One pixel of the file per layout pixel</string>
    <string name="settings_scale_desc">A phone screen packs two or three real pixels into one layout pixel, so the two answers are a long way apart: the first shows the file as it is, the second shows it the size a web page would.</string>

    <string name="settings_info_position">Details panel</string>
    <string name="settings_top">At the top</string>
    <string name="settings_bottom">At the bottom</string>
    <string name="settings_info_visible">Panel showing at first</string>

    <string name="settings_reverse_order">Change the direction of the picture sequence (by date)</string>
    <string name="settings_reverse_order_desc">Off, you leaf from the newest picture towards the older ones, the way a phone gallery goes. On, in chronological order, from the oldest to the newest.</string>

    <!-- Off by default, and the second sentence is the reason why: the system notice
         is the cost of the feature, so it belongs next to the switch rather than as a
         surprise the first time the app opens. -->
    <string name="settings_clipboard">Read the clipboard at startup</string>
    <string name="settings_clipboard_desc">Opening the app from its icon, an address in the clipboard that points straight at an image opens that image. Android shows a notice every time an app reads the clipboard, so leaving this off means never seeing it.</string>
    <string name="settings_start_folder">Open a folder at startup</string>
    <string name="settings_start_folder_desc">Opening the app shows the pictures in the chosen folder straight away, instead of the folder list.</string>
    <string name="settings_start_folder_none">No folder chosen</string>
    <string name="settings_start_folder_pick">Choose</string>


    <string name="folders_title">Folders</string>
    <string name="folders_permission">Listing the folders needs access to all files. It is the same permission that lets you leaf through a folder, and it is granted from a system page.</string>
    <string name="folders_grant">Grant access</string>
    <string name="folders_none">No folder holds pictures.</string>
    <!-- ── The little square button, bottom right of the folders screen ── -->
    <!-- It is the app's whole menu now that the opening screen is gone, so it has to
         say so rather than name one of the things behind it. -->
    <string name="hub_open">More</string>
    <!-- Each of these names the view you would GET, not the one you are in: a menu
         entry is a thing you ask for. -->
    <string name="hub_view_list">List view</string>
    <string name="hub_view_grid">Grid view</string>
    <string name="hub_url">Open an address</string>
    <string name="hub_pick">Open a picture</string>
    <string name="hub_settings">Settings</string>
    <string name="url_open">Open</string>
    <string name="url_recent">Opened before</string>
    <string name="folder_empty">This folder holds no pictures any more.</string>
    <string name="cancel">Cancel</string>

    <string name="hide_folder_title">Hide %1$s?</string>
    <string name="hide_folder_desc">It stops showing up among the folders to leaf through. Nothing is deleted: the pictures stay where they are, and you can bring the folder back from the settings.</string>
    <string name="hide_folder_do">Hide</string>
    <string name="settings_hidden">Hidden folders</string>
    <string name="settings_hidden_desc">Long press a folder to hide it. These no longer show up in the list, but they are untouched on the phone.</string>
    <string name="settings_hidden_show">Show</string>

    <string name="identity_repo">Open the AIV repository on GitHub</string>
    <!-- ── The grid of one folder ── -->
    <!-- Every thumbnail is tappable, so it is not decoration: this is what a screen
         reader says on it, and it has to tell WHERE in the folder that picture is. -->
    <string name="grid_item">Picture %1$d of %2$d</string>
    <!-- The one the reader came back from: a screen reader has to say so, because
         the ring around it is the visual form of exactly this. -->
    <string name="grid_item_last">Picture %1$d of %2$d, the last one you looked at</string>

    <plurals name="folders_count">
        <item quantity="one">%1$d picture</item>
        <item quantity="other">%1$d pictures</item>
    </plurals>

</resources>
