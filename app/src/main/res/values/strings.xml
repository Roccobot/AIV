    <string name="facts_name">File name</string>
    <string name="facts_kind">File type</string>
    <string name="facts_pixels">Pixels</string>
    <string name="facts_size">Size</string>
    <string name="facts_taken">Date taken</string>
    <string name="facts_modified">Last modified</string>
