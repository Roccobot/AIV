    <string name="settings_reset_hints">Tips terughalen</string>
    <string name="settings_reset_hints_desc">De uitleg van de sneltoetsen verschijnt weer, net als bij een nieuwe installatie.</string>
    <string name="settings_reset_hints_do">Terughalen</string>
