    <string name="settings_hidden">Verborgen mappen</string>
    <string name="settings_hidden_desc">Houd een map ingedrukt om ze te verbergen. Deze verschijnen niet meer in de lijst, maar op de telefoon zijn ze onaangeroerd.</string>
