    <string name="settings_folder_columns">Safu kwenye gridi ya folda</string>
    <string name="settings_folder_columns_desc">Safu nyingi zaidi huingiza folda nyingi zaidi kwenye skrini na kufanya kila jalada kuwa dogo. Kwa nne, jina lililo chini mara nyingi hukatwa.</string>
    <string name="settings_folder_count">Idadi ya picha chini ya folda</string>
    <string name="settings_folder_count_desc">Chini ya kila jalada, picha ngapi zimo kwenye folda. Ukiizima mstari unakuwa mfupi, na kichwa cha ukurasa kinakua kwa kiasi hicho.</string>
    <string name="settings_fit_grow">Kuza picha ndogo</string>
    <string name="settings_fit_grow_desc">Ikizimwa, picha ndogo kuliko skrini huonyeshwa kwa ukubwa wake halisi. Ikiwashwa, hukua hadi ijaze skrini.</string>
    <string name="settings_zoom_max">Ukuzaji wa juu</string>
    <string name="settings_scale_mode" formatted="false">Maana ya 100%</string>
    <string name="settings_scale_physical">Pikseli moja ya faili kwa pikseli moja ya skrini</string>
    <string name="settings_scale_logical">Pikseli moja ya faili kwa pikseli moja ya mpangilio</string>
    <string name="settings_scale_desc">Skrini ya simu huweka pikseli mbili au tatu halisi ndani ya pikseli moja ya mpangilio, kwa hivyo majibu mawili yapo mbali sana: la kwanza linaonyesha faili kama ilivyo, la pili kwa ukubwa ambao ukurasa wa wavuti ungeonyesha.</string>
    <string name="details_bar">Mstari wa maelezo</string>
    <string name="settings_top">Juu</string>
    <string name="settings_bottom">Chini</string>
    <string name="settings_info_visible">Onyesha mstari tangu mwanzo</string>
    <string name="settings_reverse_order">Geuza mpangilio wa picha (kwa tarehe)</string>
    <string name="settings_reverse_order_desc">Ikizimwa, unapitia kutoka picha mpya kuelekea za zamani, kama kwenye ghala la simu. Ikiwashwa, kwa mpangilio wa wakati, kutoka ya zamani hadi mpya.</string>
    <string name="settings_clipboard">Soma ubao wa kunakili unapoanza</string>
    <string name="settings_clipboard_desc">Ukifungua programu kwa aikoni yake, anwani iliyo kwenye ubao wa kunakili inayoelekea moja kwa moja kwenye picha hufungua picha hiyo. Android huonyesha taarifa kila programu inaposoma ubao huo: kuiacha imezimwa ni kutoiona kamwe.</string>
    <string name="settings_start_folder">Fungua folda unapoanza</string>
    <string name="settings_start_folder_desc">Programu ikifunguka huonyesha moja kwa moja picha za folda uliyochagua, badala ya orodha ya folda.</string>
