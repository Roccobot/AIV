    <string name="convert_elsewhere">Miundo mingine</string>
    <string name="convert_elsewhere_desc">Android inaweza kuandika miundo iliyo hapo juu pekee. Kwa mingine kuna huduma hizi, zinazofunguka katika kivinjari: picha huchaguliwa huko, kutoka kwenye hifadhi ya simu.</string>
    <string name="convert_clean">Safisha</string>
    <string name="convert_clean_why">Huondoa vichwa, metadata, maoni, skripti, C2PA na masalia ya vihariri, ambayo ni data nzito zaidi (hadi 99% ya faili) na hayahitajiki mara nyingi.</string>
