    <string name="settings_veil">Ukungu nyuma ya paneli</string>
    <string name="settings_veil_desc">Hutia ukungu na kutia giza skrini iliyo nyuma ya vidirisha, menyu na paneli. Kwenye vifaa vya zamani, programu inaweza kuwa polepole zaidi.</string>
    <string name="settings_folder_columns">Safu kwenye gridi ya folda</string>
    <string name="settings_folder_columns_desc">Safu nyingi zaidi huingiza folda nyingi zaidi kwenye skrini na kufanya kila jalada kuwa dogo. Kwa nne, jina lililo chini mara nyingi hukatwa.</string>
    <string name="settings_folder_count">Kihesabu cha vipengele chini ya folda katika mwonekano wa gridi</string>
    <string name="settings_hand">Upande wa vitufe vinavyoelea (\'FAB\')</string>
    <string name="settings_hand_desc">Kitufe kinachoelea kiko kwenye pembe gani ya chini, pamoja na kidirisha kinachofungua na nafasi ambayo gridi inakiachia.</string>
    <string name="settings_right">Kulia</string>
    <string name="settings_left">Kushoto</string>
    <string name="settings_list_path">Orodha ya faili: nakili njia ya folda</string>
    <string name="settings_list_path_desc">Unaponakili orodha ya majina ya faili, huongeza juu njia kamili ya folda ya asili.</string>
    <string name="settings_folder_count_desc">Chini ya kila hakikisho la folda vitaonekana kihesabu cha picha na kihesabu cha video.</string>
    <string name="settings_fit_grow">Kuza picha ndogo</string>
    <string name="settings_fit_grow_desc">Ikizimwa, picha ndogo kuliko skrini huonyeshwa kwa ukubwa wake halisi. Ikiwashwa, hukua hadi ijaze skrini.</string>
    <string name="settings_zoom_max">Ukuzaji wa juu</string>
