<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="window_background">#101619</color>
    <!-- Launcher icon, DARK version. Contrast 8.27, measured on the same pair
         the light one is measured on. Same hue family as the light version on
         purpose: the icon has to read as the same app in both themes, not as
         two icons.
         Which of the two the launcher shows is resolved with the SYSTEM
         configuration, so it follows the device theme; but launchers cache
         icons aggressively, so the switch can lag until the cache turns over.
         Android 13 and up can also tint the monochrome layer instead, when the
         user turns themed icons on. -->
    <color name="launcher_background">#12222E</color>
    <color name="launcher_foreground">#7FC0F0</color>
</resources>
