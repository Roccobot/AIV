    <string name="grid_item">Immagine %1$d di %2$d</string>

    <plurals name="folders_count">
        <item quantity="one">%1$d immagine</item>
        <!-- ⚠️ La categoria `many` dell'italiano non è un doppione di `other`: il CLDR la
             usa per i numeri grandi in forma compatta ('un milione di immagini'), e senza
             di lei lint segnala la traduzione come incompleta. Qui il testo coincide, e
             va bene: coincidere è diverso da mancare. -->
        <item quantity="many">%1$d immagini</item>
        <item quantity="other">%1$d immagini</item>
    </plurals>

