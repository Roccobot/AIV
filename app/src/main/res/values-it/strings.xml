    <string name="settings_ui_theme">Tema</string>
    <string name="settings_ui_theme_desc">Se l\'app è chiara o scura. È un\'altra cosa dal fondo dietro la fotografia, qui sotto: la scacchiera serve a far vedere la trasparenza, non a intonarsi.</string>
