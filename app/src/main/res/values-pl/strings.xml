    <string name="settings_auto">Automatycznie</string>
    <string name="settings_light">Jasne</string>
    <string name="settings_dark">Ciemne</string>
    <string name="settings_folder_columns">Kolumny w siatce folderów</string>
    <string name="settings_folder_columns_desc">Więcej kolumn mieści na ekranie więcej folderów i zmniejsza każdą okładkę. Przy czterech nazwa pod nią zwykle się urywa.</string>
    <string name="settings_folder_count">Liczba obrazów pod folderami</string>
    <string name="settings_folder_count_desc">Pod każdą okładką, ile obrazów zawiera folder. Po wyłączeniu wiersz staje się krótszy, a nagłówek u góry rośnie o tyle samo.</string>
    <string name="settings_fit_grow">Powiększaj małe obrazy</string>
    <string name="settings_fit_grow_desc">Wyłączone, obraz mniejszy od ekranu jest pokazywany w prawdziwym rozmiarze. Włączone, rośnie aż wypełni ekran.</string>
    <string name="settings_zoom_max">Największe powiększenie</string>
    <string name="settings_scale_mode">Co znaczy 100%</string>
    <string name="settings_scale_physical">Jeden piksel pliku na piksel ekranu</string>
    <string name="settings_scale_logical">Jeden piksel pliku na piksel układu</string>
    <string name="settings_scale_desc">Ekran telefonu upycha dwa albo trzy prawdziwe piksele w jednym pikselu układu, więc obie odpowiedzi są od siebie daleko: pierwsza pokazuje plik takim, jaki jest, druga w rozmiarze, w jakim pokazałaby go strona internetowa.</string>
    <string name="details_bar">Pasek szczegółów</string>
    <string name="settings_top">U góry</string>
    <string name="settings_bottom">U dołu</string>
    <string name="settings_info_visible">Pasek widoczny od początku</string>
    <string name="settings_reverse_order">Odwróć kierunek kolejności obrazów (według daty)</string>
    <string name="settings_reverse_order_desc">Wyłączone, przeglądasz od najnowszego obrazu w stronę starszych, tak jak galeria w telefonie. Włączone, w kolejności czasu, od najstarszego do najnowszego.</string>
    <string name="settings_clipboard">Czytaj schowek przy uruchomieniu</string>
    <string name="settings_clipboard_desc">Przy otwarciu aplikacji z jej ikony adres w schowku wskazujący wprost na obraz otwiera ten obraz. Android pokazuje powiadomienie za każdym razem, gdy aplikacja czyta schowek, więc pozostawienie tego wyłączonego oznacza, że nigdy go nie zobaczysz.</string>
    <string name="settings_start_folder">Otwórz folder przy uruchomieniu</string>
    <string name="settings_start_folder_desc">Po otwarciu aplikacji od razu widać obrazy z wybranego folderu, a nie listę folderów.</string>
    <string name="settings_start_folder_none">Nie wybrano folderu</string>
    <string name="settings_start_folder_pick">Wybierz</string>
    <string name="folders_title">Foldery</string>
    <string name="folders_permission">Wypisanie folderów wymaga dostępu do wszystkich plików. To ta sama zgoda, która pozwala przeglądać folder, i udziela się jej na stronie systemu.</string>
