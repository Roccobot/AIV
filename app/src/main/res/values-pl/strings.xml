    <string name="settings_fit_grow">Powiększaj małe obrazy</string>
    <string name="settings_fit_grow_desc">Wyłączone, obraz mniejszy od ekranu jest pokazywany w prawdziwym rozmiarze. Włączone, rośnie aż wypełni ekran.</string>
    <string name="settings_zoom_max">Największe powiększenie</string>
    <string name="settings_zoom_page">Dopasowanie i powiększenie</string>
    <string name="settings_zoom_page_summary">Powiększanie, maksymalne powiększenie, renderowanie pikseli</string>
    <string name="settings_scale_mode">Renderowanie pikseli</string>
    <string name="settings_scale_physical">Jeden piksel pliku na piksel ekranu</string>
    <string name="settings_scale_logical">Jeden piksel pliku na piksel układu</string>
    <string name="settings_scale_desc">Określa, czemu odpowiada powiększenie do pikseli rzeczywistych. Ekran każdego współczesnego urządzenia rysuje każdy piksel logiczny kwadratem z dwóch lub trzech pikseli rzeczywistych. Pierwszy wybór pomija piksele logiczne i odwzorowuje każdy punkt na jednym pikselu rzeczywistym; drugi pokazuje każdy obiekt w rozmiarze, jaki miałby na stronie internetowej.</string>
