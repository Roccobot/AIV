    <string name="settings_bg_solid">Jednolity kolor</string>
    <string name="settings_bg_desc">Szachownica to jedyne tło, na którym widać przezroczystość, a w przeglądarce obrazów przezroczystość jest informacją, nie ozdobą.</string>
    <string name="settings_ui_theme">Motyw</string>
    <string name="settings_ui_theme_desc">Czy sama aplikacja jest jasna czy ciemna. To coś innego niż tło za obrazem poniżej: szachownica jest po to, żeby pokazać przezroczystość, a nie żeby dopasować kolory.</string>
