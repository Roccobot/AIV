    <string name="convert_this_frame">திரையில் உள்ள %1$d ஆவது சட்டகம் ஏற்றுமதி செய்யப்படுகிறது.</string>
    <string name="convert_elsewhere">பிற வடிவங்கள்</string>
    <string name="convert_elsewhere_desc">மேலே உள்ள வடிவங்களை மட்டுமே Android எழுத முடியும். மற்றவற்றுக்கு இந்தச் சேவைகள் உள்ளன, அவை உலாவியில் திறக்கும்: படத்தை அங்கேயே, தொலைபேசி நினைவகத்திலிருந்து தேர்ந்தெடுக்கவும்.</string>
    <string name="convert_clean">சுத்தம் செய்</string>
    <string name="convert_clean_why">CleanSVG மூலம் ஒரு வெக்டர் கோப்பை 99% வரை சிறியதாக்கலாம்: மேனிலைத் தரவும் வரைபடத்துக்கு உரியதல்லாத பிற புலங்களும் நீக்கப்படும். இந்தச் சுத்தம் முற்றிலும் பாதுகாப்பானது; வடிவங்கள், கோடுகள், வரைபடங்கள், உரை அப்படியே இருக்கும்.</string>
    <string name="convert_open">திற</string>
    <string name="convert_export">ஏற்றுமதி செய்</string>
    <string name="convert_ezgif">EzGif</string>
    <string name="convert_ezgif_why">கிட்டத்தட்ட எல்லாவற்றிலிருந்தும் எல்லாவற்றுக்கும் மாற்றுகிறது, அசையும் GIF உட்பட.</string>
    <string name="convert_squoosh">Squoosh</string>
    <string name="convert_squoosh_why">Google உருவாக்கியது, உலாவியிலேயே இயங்குகிறது: படம் எங்கும் பதிவேற்றப்படுவதில்லை.</string>
    <string name="convert_cloudconvert">CloudConvert</string>
    <string name="convert_cloudconvert_why">வடிவங்களின் மிக நீண்ட பட்டியல், AVIF மற்றும் TIFF உட்பட.</string>
