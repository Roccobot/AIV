    <string name="convert_squoosh">Squoosh</string>
    <string name="convert_squoosh_why">Від Google, працює у браузері: зображення нікуди не надсилається.</string>
    <string name="convert_cloudconvert">CloudConvert</string>
    <string name="convert_cloudconvert_why">Найдовший список форматів, разом з AVIF і TIFF.</string>
