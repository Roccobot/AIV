    <string name="settings_folder_columns">ستون‌های شبکه پوشه‌ها</string>
    <string name="settings_folder_columns_desc">ستون بیشتر پوشه‌های بیشتری را در صفحه جا می‌دهد و هر جلد را کوچک‌تر می‌کند. با چهار ستون، نام زیر آن بیشتر وقت‌ها بریده می‌شود.</string>
    <string name="settings_folder_count">شمار تصاویر زیر پوشه‌ها</string>
    <string name="settings_folder_count_desc">زیر هر جلد، پوشه چند تصویر دارد. با خاموش کردنش سطر کوتاه‌تر می‌شود و سرصفحه بالا به همان اندازه بزرگ‌تر.</string>
    <string name="settings_fit_grow">بزرگ کردن تصاویر کوچک</string>
    <string name="settings_fit_grow_desc">خاموش، تصویری کوچک‌تر از صفحه به اندازه واقعی خود نشان داده می‌شود. روشن، بزرگ می‌شود تا صفحه را پر کند.</string>
    <string name="settings_zoom_max">بیشترین بزرگ‌نمایی</string>
    <string name="settings_scale_mode">معنای 100%</string>
    <string name="settings_scale_physical">یک پیکسل فایل برای هر پیکسل صفحه</string>
    <string name="settings_scale_logical">یک پیکسل فایل برای هر پیکسل چیدمان</string>
    <string name="settings_scale_desc">صفحه گوشی دو یا سه پیکسل واقعی را در یک پیکسل چیدمان جا می‌دهد، پس دو پاسخ فاصله زیادی دارند: نخستین فایل را همان‌گونه که هست نشان می‌دهد، دومی به اندازه‌ای که یک صفحه وب نشان می‌داد.</string>
    <string name="details_bar">نوار جزئیات</string>
    <string name="settings_top">در بالا</string>
