    <string name="settings_ui_theme">پوسته</string>
    <string name="settings_ui_theme_desc">اینکه خود برنامه روشن باشد یا تیره. این با پس‌زمینه پشت تصویر که همین پایین است تفاوت دارد: شطرنجی برای نشان دادن شفافیت است، نه برای هماهنگی رنگ.</string>
