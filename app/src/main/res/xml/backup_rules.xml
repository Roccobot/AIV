<?xml version="1.0" encoding="utf-8"?>
<!-- Che cosa il sistema salva e ripristina, su Android 11 e più vecchi.

     ⚠️⚠️ IL PERCHÉ DI OGNI RIGA STA NEL FILE GEMELLO `data_extraction_rules.xml`, che copre
     Android 12 in su: i due si leggono insieme e dicono la stessa cosa.

     ⚠️ I DUE FILE SONO SEPARATI PERCHÉ LO CHIEDE ANDROID e non per scelta: da Android 12
     conta `dataExtractionRules`, prima contava `fullBackupContent`, e il manifest dichiara
     entrambi. Chi cambia uno dei due cambi anche l'altro, o il difetto torna su metà dei
     telefoni. -->
<full-backup-content>
    <include domain="file" path="datastore" />
    <include domain="file" path="presets.json" />
    <include domain="file" path="watermark" />
    <include domain="file" path="covers" />
</full-backup-content>
