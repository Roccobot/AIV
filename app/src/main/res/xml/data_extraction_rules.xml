<?xml version="1.0" encoding="utf-8"?>
<!-- Che cosa il sistema salva e ripristina, da Android 12 in su.

     ⚠️⚠️ SI SALVA QUELLO CHE IL FILE DI IMPOSTAZIONI DELL'APP CHIAMA IMPOSTAZIONI, DALLA `6.29`
     (rilievi F11, F12 ed E1 della revisione della 6.25):
     - `datastore`: ogni impostazione e l'elenco delle immagini recenti (`Settings.kt`,
       `aiv-settings`). Le recenti sono INDIRIZZI e non file, quindi pesano nulla.
     - `presets.json`: i tuoi stili (`Preset.kt`).
     - `watermark`: la copia del logo della filigrana (`Watermark.kt`).
     - `covers`: le copertine scelte per le cartelle (`FolderCover.kt`).
     Fino alla `6.28` c'era il solo `datastore`, e cambiando telefono tornavano le impostazioni
     ma non gli stili, il logo e le copertine, che `Backup.kt` mette nelle sue aree come le altre.

     ⚠️⚠️ LE `SharedPreferences` RESTANO FUORI DALLA `6.29`, e non per dimenticanza: sono due, e
     tutte e due sono misure del telefono e non scelte. `keyboard` (`Centred.kt`) è l'altezza
     della tastiera, e sul telefono nuovo la prima finestra in cui si scrive si posava con quella
     del vecchio; `updates` (`Updater.kt`) è il giorno dell'ultimo controllo degli
     aggiornamenti. Fino alla `6.28` `sharedpref` era incluso, e il commento diceva che l'app non
     ne usava nessuna.

     ⚠️ SI SALVANO LE SOLE PREFERENZE E LE COSE FATTE DALL'UTENTE: le immagini sono del telefono
     e non dell'app, e un backup che se le portasse dietro sarebbe una sorpresa che nessuno ha
     chiesto.

     ⚠️ VA PROVATO SU UN TELEFONO, e la prova non è leggere questo file: si fa un backup, si
     disinstalla, si reinstalla, e si guarda se impostazioni, stili, logo e copertine sono
     tornati. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore" />
        <include domain="file" path="presets.json" />
        <include domain="file" path="watermark" />
        <include domain="file" path="covers" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore" />
        <include domain="file" path="presets.json" />
        <include domain="file" path="watermark" />
        <include domain="file" path="covers" />
    </device-transfer>
</data-extraction-rules>
