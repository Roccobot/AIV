<?xml version="1.0" encoding="utf-8"?>
<!-- Le lingue di AIV per la pagina 'Lingua dell'app' di Android 13 e successivi, dove il sistema
     sceglie la lingua di un'app sola (dalla 6.30, rilievo F15 della revisione Setaccio). Una riga
     per ogni cartella values-* con le traduzioni. Scritto a mano perché la versione generata dalla
     build elencava l'indonesiano due volte: la cartella values-in la copia la build da values-id
     (scelta Q1). LingueAppTest lo confronta con le cartelle, così una lingua nuova non resta fuori. -->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
