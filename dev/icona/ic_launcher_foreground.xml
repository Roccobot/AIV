<?xml version="1.0" encoding="utf-8"?>
<!-- AIV app icon, foreground layer. 108dp viewport, glyph inside the 66dp safe zone.
     The A's counter is left transparent so ic_launcher_background shows through it:
     do NOT fill it, and do NOT put a chequerboard in it. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- the sun disc, outside the A, upper left -->
    <path
        android:fillColor="#EBFFF7"
        android:pathData="M30,19a10,10 0 1,0 0,20a10,10 0 1,0 0,-20z" />

    <!-- the A of AIV: rounded corners come from the round-joined stroke drawn
         with the same colour as the fill, exactly as the SVG master does -->
    <path
        android:fillColor="#EBFFF7"
        android:fillType="evenOdd"
        android:strokeColor="#EBFFF7"
        android:strokeWidth="10"
        android:strokeLineJoin="round"
        android:pathData="M54,30 L84,74 L24,74 Z M54,51 L66,68 L42,68 Z" />
</vector>
